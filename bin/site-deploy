#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Kamal reads every secret in .kamal/secrets on each command, including the relay's,
# so this loads the same file as bin/relay-deploy. It deploys only the website.
env_file="${SPPPD_ENV:-$HOME/.config/hblabs/spppd.env}"
if [ ! -f "$env_file" ]; then
  echo "$env_file is missing. Run make deploy-relay once first; it creates it." >&2
  exit 1
fi
set -a; . "$env_file"; set +a

# make site has filled site/public/download; the image serves what's there.
[ -n "$(ls site/public/download 2>/dev/null)" ] || { echo "Run make site first." >&2; exit 1; }

exec "${KAMAL_BIN:-kamal}" deploy "$@"
