# The website at https://$SPPPD_DOMAIN (spppd.xyz). kamal-proxy sits in front, does TLS
# and health checks /up. Caddy logs no requests (no `log` directive).
{
	admin off
	# kamal-proxy, on the kamal network, says who the visitor is. {client_ip} is then
	# the visitor, which the track server needs to count uploads. Strict reads
	# X-Forwarded-For from the right, so a visitor can't put a made-up address first.
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:80 {
	# Old names (SPPPD_OLD_DOMAINS in .env) go to the real one, path and all. Not /up:
	# kamal-proxy's health check comes in under no particular name.
	@elsewhere {
		not host {$SPPPD_DOMAIN:spppd.xyz}
		not path /up
	}
	redir @elsewhere https://{$SPPPD_DOMAIN:spppd.xyz}{uri} permanent

	handle /up {
		respond "ok" 200
	}

	# The online server's public status, for /status/. The relay serves it on the
	# kamal network, where its container is spppd-relay. It's down when the relay is.
	handle /api/status {
		reverse_proxy {$SPPPD_RELAY_STATUS:spppd-relay:8081}
	}

	# The track server, for /tracks/: the list, track files and uploads. Uploads are
	# small, and the relay counts them by the visitor's address.
	handle /api/tracks* {
		request_body {
			max_size 128KB
		}
		reverse_proxy {$SPPPD_RELAY_STATUS:spppd-relay:8081} {
			header_up X-Real-IP {client_ip}
		}
	}

	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
	}

	# Umami's script and its reports go to stats.hblabs.xyz; nothing else leaves.
	@pages not path /play/*
	header @pages Content-Security-Policy "default-src 'self'; script-src 'self' https://stats.hblabs.xyz; connect-src 'self' https://stats.hblabs.xyz; img-src 'self'; media-src 'self'; style-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"

	# The browser version (make web). The same, plus compiling LÖVE's WebAssembly.
	# Its files keep their names from one version to the next, so the browser checks
	# them each visit (a 304 when nothing's changed).
	@play path /play/*
	header @play {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://stats.hblabs.xyz; connect-src 'self' https://stats.hblabs.xyz; img-src 'self'; media-src 'self'; style-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
		Cache-Control "no-cache"
	}

	# Astro names these by their contents, so they never change.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@media path /media/* /fonts/*
	header @media Cache-Control "public, max-age=604800"

	# Downloads come from the GitHub release now. Old links still work.
	@download path_regexp download ^/download/(spppd-(\d+\.\d+\.\d+)[^/]*)$
	redir @download https://github.com/vanillaiice/spppd/releases/download/v{re.download.2}/{re.download.1} 302

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
