<?xml version="1.0" encoding="utf-8"?>
<!-- Copied into love-android by android/prepare.sh. SPPPD never records, and it may
     talk plain HTTP to a relay run at home, whose track list has nothing else
     (Android refuses plain HTTP unless told; the game itself only sends tracks over
     it to addresses on your own network, see src/net_http.lua). -->
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <application android:usesCleartextTraffic="true" />
</manifest>
